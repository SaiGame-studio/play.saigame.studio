# Backend API (ss-go). Must be a sibling subdomain of this site so the shared
# SSO cookie (Domain=.saigame.studio) is sent with requests.
NEXT_PUBLIC_API_URL=http://local-api.saigame.studio:82

# Studio frontend, linked from the header. Signing in on either site signs in both.
NEXT_PUBLIC_STUDIO_URL=http://local-server.saigame.studio:81

# Google Sign-In client ID (add this site's origin to "Authorized JavaScript origins").
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
